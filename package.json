{
  "name": "@typeflowjs/converters",
  "version": "0.0.1",
  "description": "Typeflow converters as a native Node.js addon, written in Rust",
  "license": "MIT",
  "author": "Typeflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/typeflow/converters"
  },
  "files": [
    "dist",
    "index.d.ts",
    "*.node"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "cargo test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.0",
    "@typeflowjs/lint-config": "github:typeflow/lint-config",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0"
  },
  "optionalDependencies": {
    "@typeflowjs/converters-darwin-arm64": "0.0.1",
    "@typeflowjs/converters-darwin-x64": "0.0.1",
    "@typeflowjs/converters-linux-x64-gnu": "0.0.1",
    "@typeflowjs/converters-win32-x64-msvc": "0.0.1"
  },
  "napi": {
    "name": "typeflow-converters",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "engines": {
    "node": ">= 18"
  }
}
